# ============================================================
# Postit backend - environment
# Copy to `.env` and fill in. Everything has a safe local default.
# ============================================================

# ---- App ----
ENVIRONMENT=development            # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- Database ----
# Local dev (zero setup): SQLite via aiosqlite.
DATABASE_URL=sqlite+aiosqlite:///./postit.db
# Production target: MySQL 8 via aiomysql, e.g.
# DATABASE_URL=mysql+aiomysql://postit:postit@localhost:3306/postit?charset=utf8mb4
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- Redis (optional) ----
# Leave empty to use the built-in in-memory fallback for cache / rate-limit / denylist.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ---- JWT / auth ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Fernet key (urlsafe base64, 32 bytes) used to encrypt stored OAuth connection tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=109mKOJ-db3IOpEFH0bzdb01fDkX8ez9UKqxWp8kwvM=

# ---- CORS / frontend ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ---- Scheduler / publish worker ----
# The in-process worker drains the publish_jobs outbox so scheduled posts go out
# at their time. Keep enabled on exactly ONE process when running multiple workers.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=10
SCHEDULER_MAX_ATTEMPTS=3

# ---- AI provider (pluggable) ----
# Leave AI_PROVIDER=mock (or omit AI_API_KEY) to use the built-in deterministic
# rewriter - fully offline, zero cost. To use a real model, set the provider and
# its key (model/base_url are optional; sensible defaults are applied):
#   AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...     (AI_MODEL=claude-sonnet-4-6)
#   AI_PROVIDER=openai     AI_API_KEY=sk-...          (AI_MODEL=gpt-4o-mini)
#   AI_PROVIDER=groq       AI_API_KEY=gsk_...         (AI_MODEL=llama-3.3-70b-versatile)
#   AI_PROVIDER=gemini     AI_API_KEY=...             (AI_MODEL=gemini-1.5-flash)
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=600

# ---- Paddle Billing (SANDBOX) ----
# Create a free sandbox at https://sandbox-vendors.paddle.com, then from
# Developer tools → Authentication / Notifications copy:
#   PADDLE_API_KEY       - server-side API key
#   PADDLE_CLIENT_TOKEN  - public client-side token (used by Paddle.js)
#   PADDLE_WEBHOOK_SECRET - webhook signing secret
# Billing endpoints return 503 until PADDLE_API_KEY is set - the rest of the app runs fine.
# Sandbox test card: 4242 4242 4242 4242, any future expiry, any CVC.
PADDLE_API_KEY=pdl_sdbx_apikey_REPLACE_ME
PADDLE_CLIENT_TOKEN=test_REPLACE_ME
PADDLE_WEBHOOK_SECRET=pdl_ntfset_REPLACE_ME
PADDLE_ENVIRONMENT=sandbox
PADDLE_CURRENCY=USD

# ============================================================
# Social OAuth (per-platform apps + callback URLs)
# ============================================================
# PUBLIC_API_URL is the externally reachable base of THIS API (no trailing slash).
# In prod set it to your real domain, e.g. https://api.postit.app
# Every callback URL below is derived from it. Paste these into each platform's
# developer console (for Threads/Facebook/Instagram these are the Redirect,
# Uninstall/Deauthorize, and Delete callbacks):
#
#   Redirect:     {PUBLIC_API_URL}/api/v1/connections/{platform}/callback
#   Deauthorize:  {PUBLIC_API_URL}/api/v1/webhooks/{platform}/deauthorize
#   Delete:       {PUBLIC_API_URL}/api/v1/webhooks/{platform}/delete
#
# e.g. for Threads with the default base:
#   http://localhost:8000/api/v1/connections/threads/callback
#   http://localhost:8000/api/v1/webhooks/threads/deauthorize
#   http://localhost:8000/api/v1/webhooks/threads/delete
#
# A superuser can see the full list (with copy-ready URLs) at GET /api/v1/admin/integrations
# or in the admin "Platforms" page.
PUBLIC_API_URL=http://localhost:8000
# Shared verify token for the Meta-style webhook GET handshake (hub.verify_token).
OAUTH_WEBHOOK_VERIFY_TOKEN=change-me-verify-token

# Per-platform OAuth app credentials (leave blank until you create each app).
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=

# ---- Product import (Alibaba + AliExpress affiliate APIs) ----
# Powers the "Import products" buttons in the composer. Leave blank to disable a
# source (the button reports "not configured"). Credentials come from the same
# affiliate accounts used by the AliProds / BabaProds WordPress plugins.
#
# AliExpress Affiliate Open Platform (https://portals.aliexpress.com):
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_TARGET_CURRENCY=USD
ALIEXPRESS_TARGET_LANGUAGE=EN
#
# Alibaba Open Platform (https://openapi.alibaba.com). access/refresh tokens come
# from the console OAuth flow; the access token auto-refreshes at runtime.
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_REFRESH_TOKEN=
ALIBABA_AFFILIATE_CODE=jnqilrll
# Destination country for product pricing/shipping (ISO-2).
PRODUCT_SHIP_TO_COUNTRY=US

# ---- Seed (demo data) ----
SEED_SUPERADMIN_EMAIL=admin@postit.app
SEED_SUPERADMIN_PASSWORD=admin12345
SEED_DEMO_EMAIL=rina@maple.co
SEED_DEMO_PASSWORD=password123
