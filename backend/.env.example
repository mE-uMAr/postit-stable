# ============================================================
# Postit backend — environment
# Copy to `.env` and fill in. Everything has a safe local default.
# ============================================================

# ---- App ----
ENVIRONMENT=development            # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO

# ---- Database ----
# Local dev (zero setup): SQLite via aiosqlite.
DATABASE_URL=sqlite+aiosqlite:///./postit.db
# Production target: MySQL 8 via aiomysql, e.g.
# DATABASE_URL=mysql+aiomysql://postit:postit@localhost:3306/postit?charset=utf8mb4
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- Redis (optional) ----
# Leave empty to use the built-in in-memory fallback for cache / rate-limit / denylist.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ---- JWT / auth ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# Fernet key (urlsafe base64, 32 bytes) used to encrypt stored OAuth connection tokens.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- CORS / frontend ----
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ---- Stripe (TEST MODE) ----
# Paste your own test keys from https://dashboard.stripe.com/test/apikeys
# Billing endpoints return 503 until a secret key is set — the rest of the app runs fine.
# Test card: 4242 4242 4242 4242, any future expiry, any CVC, any ZIP.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_CURRENCY=usd

# ---- Seed (demo data) ----
SEED_SUPERADMIN_EMAIL=admin@postit.app
SEED_SUPERADMIN_PASSWORD=admin12345
SEED_DEMO_EMAIL=rina@maple.co
SEED_DEMO_PASSWORD=password123
