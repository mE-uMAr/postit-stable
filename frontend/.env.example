# Backend base URL used by Next.js server-side route handlers (proxy + auth).
# Read ONLY on the server (no NEXT_PUBLIC_ prefix), so the backend URL is never
# exposed to the browser — all client calls go through the same-origin /api/proxy/*.
#
#   Local dev:   http://localhost:8000
#   Production:  https://postit.fastapicloud.dev   <-- set this in the frontend host's env
API_URL=http://localhost:8000

# Paddle's public client token + environment are returned by the backend's
# /billing/checkout response (sourced from the backend .env), so no payment key
# is required here. Configure PADDLE_* in backend/.env instead.
